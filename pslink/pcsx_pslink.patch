+#ifndef __SIO1_H__
+#define __SIO1_H__
+/* the serial port (link cable), see sio1.c */
+u32  sio1Read(u32 ofs, int size);
+void sio1Write(u32 ofs, u32 v, int size);
+void sio1Interrupt(void);
+void sio1Reset(void);
+/* for the frontend */
+#ifdef _WIN32
+#define PSLINK_API __declspec(dllexport)
+#else
+#define PSLINK_API
+#endif
+PSLINK_API void pslink_sio1_set_tx(void (*cb)(unsigned char));
+PSLINK_API void pslink_sio1_rx(const unsigned char *d, int n);
+PSLINK_API void pslink_sio1_connect(int on);
+PSLINK_API int  pslink_sio1_pending(void);
+#endif
